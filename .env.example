# ─────────────────────────────────────────────────────────────────────────────
# Juva mobile environment
#
# Copy to `.env` for local work. `.env` is gitignored: never commit real keys.
# Only EXPO_PUBLIC_* values reach the app bundle, and they are PUBLIC — treat
# every one of them as readable by anyone who installs the app. Secret keys
# (RevenueCat secret keys, OpenRouter keys) belong in services/api/.env only.
#
# Per-profile values are set in eas.json for development / preview / production
# builds. This file is the demo + local development default.
# ─────────────────────────────────────────────────────────────────────────────

# Which configuration profile this bundle represents.
#   demo        fully offline controlled market, no external service required
#   development local work against a dev API, http allowed
#   preview     internal builds, https required
#   production  store builds, https required, real store keys required
EXPO_PUBLIC_JUVA_ENV=demo

# Market data source.
#   demo    Juva's deterministic controlled market. Labelled DEMO in the UI.
#   remote  calls EXPO_PUBLIC_API_BASE_URL/v1/market/search
# Ignored when EXPO_PUBLIC_JUVA_ENV=demo, which always uses the demo market.
EXPO_PUBLIC_MARKET_MODE=demo

# Juva API origin. Required for remote market mode and for receipt extraction.
# Must be https in preview and production builds.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# RevenueCat PUBLIC SDK keys. Never put a RevenueCat secret key here.
# demo/development prefer the Test Store key; preview/production refuse it.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Native identifiers and the OTA channel, read by app.config.ts at build time.
# Leave these unset to use the per-profile defaults from app.config.ts
# (com.juva.mobile.demo / .dev / .preview / com.juva.mobile). Set them only to
# force a specific identifier, e.g. from EAS secrets.
# JUVA_IOS_BUNDLE_ID=
# JUVA_ANDROID_PACKAGE=
JUVA_BUILD_CHANNEL=development

# Optional crash and performance monitoring. Absent means no monitoring at all.
EXPO_PUBLIC_SENTRY_DSN=

# Optional lifecycle push. Absent means no push and no journeys.
# Needs a development build: OneSignal is a native module and is unavailable in Expo Go.
EXPO_PUBLIC_ONESIGNAL_APP_ID=
