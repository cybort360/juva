{
  "name": "juva",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --no-install",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p services/api/tsconfig.json",
    "test": "rm -rf .tmp-domain && tsc -p tsconfig.domain.json && node --test .tmp-domain/tests/*.test.js",
    "doctor": "expo-doctor",
    "api": "npm --prefix services/api run dev",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:api",
    "test:api": "npm --prefix services/api test",
    "secrets": "node scripts/secret-scan.mjs",
    "audit": "node scripts/audit.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:api && npm run secrets && npm run doctor && npm run audit",
    "assets": "node scripts/make-assets.mjs",
    "env:check": "node scripts/env-check.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~56.0.19",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.23",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-file-system": "~56.0.9",
    "expo-haptics": "~56.0.3",
    "expo-image-manipulator": "~56.0.24",
    "expo-linking": "~56.0.16",
    "expo-notifications": "~56.0.23",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "onesignal-expo-plugin": "^2.7.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-onesignal": "^5.5.6",
    "react-native-purchases": "10.4.4",
    "react-native-purchases-ui": "10.4.4",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
