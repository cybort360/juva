{
  "name": "@juva/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .tmp-api && tsc -p tsconfig.test.json && node --test .tmp-api/tests/*.test.js",
    "live-check": "tsx --env-file-if-exists=.env scripts/live-check.ts",
    "probe": "tsx --env-file-if-exists=.env scripts/probe-extraction.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
