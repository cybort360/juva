PORT=8787
ALLOWED_ORIGIN=http://localhost:8081
# Provider endpoint. Defaults to OpenRouter when unset. Any OpenAI-compatible host works;
# verify vision + json_schema support first with: npm --prefix services/api run probe
OPENROUTER_BASE_URL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_APP_URL=https://juva.app
OPENROUTER_APP_NAME=Juva
# ── Real retailer data layer ─────────────────────────────────────────────────
# Comma-separated adapter ids to enable. Empty means no real price source is
# called and /v1/market/search returns 503 unless a feed is configured below.
# Available: open_prices
JUVA_RETAILER_ADAPTERS=

# Required by the Nominatim and Overpass usage policies: a contactable identifier.
# Requests without one may be blocked. See docs/REAL_DATA.md.
JUVA_CONTACT_USER_AGENT=Juva/0.2 (you@example.com)

# JSON array of authorized normalized retailer feed adapters.
# Each endpoint must accept POST { concepts, location, radiusMiles, currency }
# and return { stores: [...], products: [...] } in Juva's normalized feed contract.
JUVA_RETAILER_FEEDS_JSON=[]
