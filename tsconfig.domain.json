{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".tmp-domain",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/config/env.ts", "src/domain/**/*.ts", "src/utils/**/*.ts", "tests/**/*.ts"]
}
